# Settings loads learntrail-agent/.env; process environment variables take priority.
# Copy to .env locally when needed; never commit real credentials.
# python -m learntrail_agent binds to 127.0.0.1:8100 for local verification only.
APP_NAME=LearnTrail AI
LEARNTRAIL_AI_ENV=local

# API base including its version prefix, e.g. https://provider.example/v1
# Do not include /chat/completions, credentials, or query parameters in the base.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Total request deadline and maximum idle read time, in seconds.
LLM_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=5
# Optional: leave blank to use the model provider's defaults.
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
# Enable only if the provider supports stream_options.include_usage.
LLM_STREAM_INCLUDE_USAGE=false

# Dedicated AI PostgreSQL database, never Java business databases.
# Leave blank to disable session storage. No migration runs automatically.
# Format: postgresql://USER:PASSWORD@127.0.0.1:5432/learntrail_ai
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Account status: GET /us/users/{verified-user-id}/enabled through the Java gateway.
JAVA_GATEWAY_BASE_URL=http://127.0.0.1:10010
JAVA_TIMEOUT_SECONDS=5
# Trusted RSA public key file only, PEM or Base64 DER from Java /jwks.
# Relative paths resolve from this Python project's root. Never use a private key/JKS.
# Example: repository-root .local/java-public-key.pem; configure its absolute path.
JWT_PUBLIC_KEY_FILE=
CONTEXT_MAX_TURNS=10
# Character budget, not a token counter. Whole oldest turns are removed first.
CONTEXT_MAX_CHARS=60000

# Independent Embeddings API; never implicitly reuse the chat model/key.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Set the model's verified output dimensions. No default or implicit truncation.
EMBEDDING_DIMENSIONS=
# Only enable if this provider/model supports the optional dimensions parameter.
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# Optional version label; change when a provider reassigns an existing model alias.
EMBEDDING_MODEL_REVISION=
# Character budgets, not a provider-specific token count; verify token limits later.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
RAG_INDEX_TIMEOUT_SECONDS=180

# Exact retrieval over this user's indexed, freshly Java-authorized articles.
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_MIN_SIMILARITY=0.35
RAG_BM25_K1=1.2
RAG_BM25_B=0.75
RAG_BM25_MIN_SCORE=0
RAG_RRF_K=60
# Refuse larger corpora; narrow article_slugs instead of silently truncating.
RAG_MAX_ARTICLES=100
RAG_CONTEXT_MAX_CHARS=12000
RAG_ANSWER_MAX_TOKENS=1500

# Optional independent reranker. Base includes API version,
# e.g. https://api.cohere.com/v2. No implicit key/model fallback.
# Leave blank unless the provider protocol/model has been verified.
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_PROTOCOL=cohere
RERANKER_PATH=/rerank
# DashScope native: protocol=dashscope; base and path must match your workspace's
# official endpoint. Native input/parameters and output.results are supported.
# Do not point the reranker at the chat/embedding endpoint or guess a model ID.
RERANKER_TIMEOUT_SECONDS=20

# LangGraph read-only Agent. These are server limits, not browser/model inputs.
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=24
AGENT_TOOL_CONCURRENCY=3
AGENT_TOOL_OUTPUT_CHARS=16000
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOKENS=1500
# provider_default omits the vendor extension; enabled/disabled sends thinking.type.
# Verify support before changing it. Provider reasoning is only replayed internally;
# resumable graph messages are encrypted, never exposed in traces or SSE.
AGENT_THINKING_MODE=provider_default
# Default: repository .local/run/learntrail-checkpoint.key (created once, mode 0600).
# Optional absolute path; preserve and back up this file with the encrypted DB.
# A missing key with existing checkpoints is an error, not an automatic rotation.
CHECKPOINT_KEY_FILE=
# Agent SSE now streams real content deltas plus node/tool events. Deltas remain
# provisional; only done confirms source verification and message/Run commit.

# Advanced Agent, after applying V006. Approvals share the private checkpoint key.
APPROVAL_TTL_SECONDS=900
MEMORY_CONTEXT_CHARS=2000
MEMORY_MAX_ITEMS=3
# Optional absolute trusted directory; default: this project's skills/.
# SKILLS_DIR=/absolute/path/to/learntrail-agent/skills
# No MCP server is enabled by default. Use a private JSON array of explicitly
# trusted profiles: id, trusted:true, transport:stdio|http, allow_tools:{name:policy}.
# stdio needs an absolute executable and args; HTTP needs an explicit URL.
# Example local stdio: command=/absolute/path/to/.venv/bin/python,
# args=["-m","learntrail_agent.mcp_demo_server"],
# allow_tools={"preview_learning_outline":"read_only","publish_demo_note":"approval_required"}.
# Profiles are an operator trust boundary; stdio is not an OS sandbox.
# Never put JWTs, API keys or database credentials in profiles or args.
# MCP_SERVERS_FILE=/absolute/private/path/mcp-servers.json
MCP_FIRST_PARTY_URL=http://127.0.0.1:8100/mcp/
# First-party HTTP MCP requires an existing Java Bearer JWT on every request.
# Trusted first-party stdio: python -m learntrail_agent.mcp_server, with the JWT
# supplied privately as LEARNTRAIL_MCP_ACCESS_TOKEN (never a CLI argument).

# Evaluation/observability. No external export or prompt capture by default.
OBSERVABILITY_ENABLED=false
# Default local private rotating JSONL: repository .local/observability/
# OBSERVABILITY_DIR=/absolute/private/path/observability
OBSERVABILITY_SAMPLE_RATE=1
OBSERVABILITY_FILE_MAX_BYTES=10485760
OTEL_METRIC_EXPORT_INTERVAL_MS=5000
# With no Collector endpoint, the existing OTel SDK writes private cumulative
# metric snapshots to .local/observability/metrics.jsonl and traces to spans.jsonl.
# Snapshots are cumulative: use time differences, do not sum successive records.
# Enable Langfuse below to send the same traces to its configured project.
# Langfuse's OTLP ingestion is for traces; do not reuse it as a metrics Collector.
# Explicit HTTPS collector base URL, or loopback HTTP. SDK appends /v1/traces
# and /v1/metrics. Headers are private comma-separated key=value pairs.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Metadata-only spans; no raw question, answer, JWT, SQL, tool args or results.
# Rates are per million tokens; use a reviewed private JSON file:
# {"version":"operator-reviewed-date","models":{"exact-model-id":
# {"input_per_million":"VERIFIED_RATE","output_per_million":"VERIFIED_RATE","currency":"CNY"}}}
# Unknown price or incomplete Usage remains unknown, never zero. Billing may
# differ for cache, tier/time-dependent rates; this is an estimate, not invoice.
# LLM_PRICING_FILE=/absolute/private/path/model-prices.json

# Independent optional evaluation judge; never implicitly uses chat credentials.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
# Fallback for standalone Judge use. Formal evaluation derives budgets from
# selected cases × schemes × repeats; --max-judge-calls overrides that run total.
JUDGE_MAX_CALLS=8
JUDGE_TIMEOUT_SECONDS=30
# auto: disable thinking + request JSON for official DeepSeek flash/v4-pro;
# omit provider-specific fields for other providers. Explicit alternatives:
# provider_default, disabled, enabled. Actual mode/latency is saved per call.
JUDGE_THINKING_MODE=auto
# A/B switches default to existing behavior. Only server/operator configuration.
AGENT_MEMORY_ENABLED=true
AGENT_SKILLS_ENABLED=true
AGENT_PROMPT_SUFFIX=
# DATABASE_SCHEMA is public for normal services. The eval CLI exclusively creates
# and removes its own random eval_ai_<uuid> schema; do not reuse a user schema.
