# Copy to .env.local and fill only the services you intend to start.
# Spring Boot does not load this file automatically. Use IDE environment
# variables, your process manager, or startup.sh -e .env.local for Docker.

# Optional Alibaba Cloud SMS credentials for tj-message.
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=

LEARNTRAIL_PAY_NOTIFY_HOST=https://payments.example.invalid
LEARNTRAIL_ALIPAY_APP_ID=
LEARNTRAIL_ALIPAY_GATEWAY_HOST=
LEARNTRAIL_ALIPAY_PRIVATE_KEY=
LEARNTRAIL_ALIPAY_PUBLIC_KEY=
LEARNTRAIL_WECHAT_APP_ID=
LEARNTRAIL_WECHAT_MERCHANT_ID=
LEARNTRAIL_WECHAT_MERCHANT_SERIAL=
LEARNTRAIL_WECHAT_PRIVATE_KEY=
LEARNTRAIL_WECHAT_API_V3_KEY=

LEARNTRAIL_TENCENT_APP_ID=
LEARNTRAIL_TENCENT_SECRET_ID=
LEARNTRAIL_TENCENT_SECRET_KEY=
LEARNTRAIL_TENCENT_VOD_URL_KEY=
LEARNTRAIL_TENCENT_COS_BUCKET=

# Optional private storage for new Studio uploads. Use an absolute directory.
LEARNTRAIL_LOCAL_VIDEO_DIR=
LEARNTRAIL_FFMPEG=ffmpeg

# Generate your own keystore; see docs/local-development.md.
LEARNTRAIL_JWT_KEY_ALIAS=learntrail-auth
LEARNTRAIL_JWT_KEYSTORE_LOCATION=file:/run/secrets/learntrail-auth.jks
LEARNTRAIL_JWT_STORE_PASSWORD=
LEARNTRAIL_JWT_KEY_PASSWORD=

# Manual payment tests are opt-in and must use explicitly selected test accounts.
LEARNTRAIL_RUN_PAYMENT_TESTS=false
LEARNTRAIL_TEST_PAY_ORDER_NO=
LEARNTRAIL_TEST_REFUND_ORDER_NO=
LEARNTRAIL_TEST_NOTIFY_URL=
